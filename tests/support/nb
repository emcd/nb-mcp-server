#!/usr/bin/env bash
set -euo pipefail

root="${NB_SHIM_ROOT:?NB_SHIM_ROOT is required}"
mkdir -p "${root}/notebooks"
echo "$*" >> "${root}/calls.log"

has_signing_overrides() {
  local count="${GIT_CONFIG_COUNT:-0}"
  local index key value
  local commit_ok=0
  local tag_ok=0
  for (( index = 0; index < count; index++ )); do
    key="$(printenv "GIT_CONFIG_KEY_${index}" || true)"
    value="$(printenv "GIT_CONFIG_VALUE_${index}" || true)"
    if [[ "${key}" == "commit.gpgsign" && "${value}" == "false" ]]; then
      commit_ok=1
    fi
    if [[ "${key}" == "tag.gpgsign" && "${value}" == "false" ]]; then
      tag_ok=1
    fi
  done
  [[ "${commit_ok}" -eq 1 && "${tag_ok}" -eq 1 ]]
}

if [[ "${1:-}" == "notebooks" && "${2:-}" == "show" ]]; then
  notebook="${3:-}"
  path="${root}/notebooks/${notebook}"
  if [[ -d "${path}" ]]; then
    echo "${path}"
    exit 0
  fi
  echo "! notebook not found: ${notebook}" >&2
  exit 1
fi

if [[ "${1:-}" == "notebooks" && "${2:-}" == "add" ]]; then
  notebook="${3:-}"
  if ! has_signing_overrides; then
    echo "signing required: passphrase prompt would appear" >&2
    exit 1
  fi
  mkdir -p "${root}/notebooks/${notebook}"
  git -C "${root}/notebooks/${notebook}" init --quiet
  touch "${root}/signing-overrides-detected"
  echo "Added notebook ${notebook}"
  exit 0
fi

if [[ "${1:-}" == "show" ]]; then
  selector="${2:-}"
  notebook="${selector%%:*}"
  path="${selector#*:}"
  if [[ "${notebook}" == "${selector}" || -z "${notebook}" || -z "${path}" ]]; then
    echo "! invalid selector: ${selector}" >&2
    exit 1
  fi
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "shown ${notebook}:${path}"
  exit 0
fi

if [[ "${1:-}" == *":add" ]]; then
  notebook="${1%%:add}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "Added: [${notebook}:1] ${notebook}/shim-note.md \"Shim Note\""
  exit 0
fi

if [[ "${1:-}" == "search" ]]; then
  # search {notebook}: query1 query2 --or --no-color
  selector="${2:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "searched ${notebook}"
  exit 0
fi

if [[ "${1:-}" == *":todo" && "${2:-}" == "add" ]]; then
  # {notebook}:todo add folder/ title --task t1 --tags #tag
  cmd="${1:-}"
  notebook="${cmd%%:todo}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "Added: [${notebook}:1] ${notebook}/shim-todo.md \"Shim Todo\""
  exit 0
fi

if [[ "${1:-}" == "list" && "${3:-}" == "--type" && "${4:-}" == "folder" ]]; then
  # list {notebook}: --type folder --no-color
  selector="${2:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "folders ${notebook}"
  exit 0
fi

if [[ "${1:-}" == "list" ]]; then
  # list {notebook}: or list {notebook}:{folder}/ --no-color --tags #tag
  selector="${2:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "listed ${notebook}"
  exit 0
fi

if [[ "${1:-}" == *":" && "${2:-}" == "status" ]]; then
  # {notebook}: status
  notebook="${1%%:}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "status ${notebook}"
  exit 0
fi

if [[ "${1:-}" == "notebooks" && "${2:-}" == "--no-color" ]]; then
  echo "notebooks"
  exit 0
fi

if [[ "${1:-}" == "edit" ]]; then
  # edit selector --overwrite --content content --no-color
  selector="${2:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "edited ${notebook}"
  exit 0
fi

if [[ "${1:-}" == "delete" ]]; then
  # delete selector --force
  selector="${2:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "Deleted ${notebook}"
  exit 0
fi

if [[ "${1:-}" == "move" ]]; then
  # move source destination
  selector="${2:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "Moved ${notebook}"
  exit 0
fi

if [[ "${1:-}" == "do" ]]; then
  # do selector
  selector="${2:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "Completed ${notebook}"
  exit 0
fi

if [[ "${1:-}" == "undo" ]]; then
  # undo selector
  selector="${2:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "Uncompleted ${notebook}"
  exit 0
fi

if [[ "${1:-}" == "tasks" ]]; then
  # tasks {notebook}: or tasks {notebook}:{folder}/ --no-color
  selector="${2:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "tasks ${notebook}"
  exit 0
fi

if [[ "${1:-}" == *"bookmark" ]]; then
  # {notebook}:bookmark or {notebook}:{folder}/bookmark
  cmd="${1:-}"
  # Extract notebook name (everything before the first colon)
  notebook="${cmd%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "bookmarked ${notebook}"
  exit 0
fi

if [[ "${1:-}" == "add" && "${2:-}" == "folder" ]]; then
  # add folder {notebook}:{path}
  selector="${3:-}"
  notebook="${selector%%:*}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "Created folder ${notebook}"
  exit 0
fi

if [[ "${1:-}" == *":import" ]]; then
  # {notebook}:import source
  notebook="${1%%:import}"
  if [[ ! -d "${root}/notebooks/${notebook}" ]]; then
    echo "! notebook not found: ${notebook}" >&2
    exit 1
  fi
  echo "imported ${notebook}"
  exit 0
fi

echo "unsupported nb command: $*" >&2
exit 2
