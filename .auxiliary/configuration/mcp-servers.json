{
  "mcpServers": {
    "agentmux": {
      "command": "agentmux",
      "args": [
        "host",
        "mcp"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "nb": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--",
        "--notebook",
        "nb-mcp-server",
        "--no-commit-signing"
      ]
    }
  }
}
