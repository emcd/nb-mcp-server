{
  "mcpServers": {
    "agentmux": {
      "command": "agentmux",
      "args": [
        "host", "mcp",
        "--bundle", "notebook"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [ "-y", "@upstash/context7-mcp" ]
    },
    "nb": {
      "command": "reloaderoo",
      "args": [
        "--",
        "cargo",
        "run",
        "--release",
        "--",
        "--notebook",
        "nb-mcp-server",
        "--no-commit-signing"
      ]
    }
  }
}
